# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# Nebius Token Factory (AI Studio) API key
NEBIUS_API_KEY=your_nebius_api_key_here

# OpenAI-compatible endpoint + model id (both optional, defaults shown)
NEBIUS_BASE_URL=https://api.studio.nebius.ai/v1
NEBIUS_MODEL=deepseek-ai/DeepSeek-V4.1-Flash

# Optional: model used for photos. Defaults to NEBIUS_MODEL.
# Set this to a vision-capable model id if NEBIUS_MODEL is text-only.
# NEBIUS_VISION_MODEL=
# NEBIUS_EMBED_MODEL=Qwen/Qwen3-Embedding-8B

# Optional: DEBUG for verbose logs, and how many past Q/A turns to keep per chat
LOG_LEVEL=INFO
HISTORY_TURNS=4
